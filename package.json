{
  "name": "ozo-dday-widget",
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "main": "public/electron.js",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "start": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && node -e \"require('fs').copyFileSync('public/icon.ico','build/icon.ico')\" && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "kill-app": "node scripts/kill-app.js",
    "clean": "npm run kill-app && node scripts/clean.js",
    "clear-icon-cache": "cmd /c \"scripts\\\\clear-icon-cache.bat\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.ozo.dday-widget",
    "productName": "OZO 디데이",
    "icon": "build/icon.ico",
    "forceCodeSigning": false,
    "afterPack": "./scripts/set-icon-after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "executableName": "OZO 디데이"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "pretendard": "^1.3.9",
    "rcedit": "^4.0.1",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  }
}
